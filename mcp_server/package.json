{
	"name": "icp-coder-mcp-server",
	"version": "0.1.0",
	"description": "Model Context Protocol server that assists with generating production-ready code in Motoko language",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"icp-coder-mcp-server": "dist/index.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"build:prod": "PROD_BACKEND_URL=http://localhost:8080 npm run build",
		"dev": "tsx --watch src/index.ts",
		"start": "node dist/index.js",
		"clean": "rm -rf dist"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.17.5",
		"zod": "^3.25.7"
	},
	"devDependencies": {
		"@types/node": "^24.7.1",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2"
	}
}
